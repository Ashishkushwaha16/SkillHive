# =====================================
# SkillHive - AI Profile
# Priority: chatgpt > gemini
# =====================================

# ---------- Node Backend ----------
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000
MONGO_URI=mongodb://127.0.0.1:27017/skillhive
JWT_SECRET=replace_with_strong_secret
JWT_EXPIRE=1d

# ---------- React Frontend ----------
REACT_APP_AI_ASSISTANT_URL=http://localhost:5050
REACT_APP_SUPPORT_EMAIL=support@skillhive.app
REACT_APP_LEGAL_VERSION=v1.0.0
REACT_APP_LEGAL_LAST_UPDATED=2026-04-18

# ---------- AI Assistant ----------
AI_PROVIDER=chatgpt
AI_ASSISTANT_PORT=5050
AI_SEARCH_QUICK_ISSUES_FILE=knowledge_base/ai_search_quick_issues.json
# Use AI_PROVIDER=ai-search for local retrieval mode (no external API key required)

# ChatGPT (Primary)
OPENAI_API_KEY=your_openai_key
OPENAI_MODEL=gpt-4o-mini

# Gemini
GEMINI_API_KEY=your_gemini_key
GEMINI_MODEL=gemini-1.5-flash


