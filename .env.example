# React frontend
REACT_APP_AI_ASSISTANT_URL=http://localhost:5050
REACT_APP_SUPPORT_EMAIL=support@skillhive.app
REACT_APP_LEGAL_VERSION=v1.0.0
REACT_APP_LEGAL_LAST_UPDATED=2026-04-18

# AI assistant provider selection
# Supported values (priority order): chatgpt, gemini, grok, perplexity, claude
AI_PROVIDER=chatgpt
AI_ASSISTANT_PORT=5050

# Grok (xAI)
XAI_API_KEY=
GROK_MODEL=grok-2-latest

# ChatGPT (OpenAI)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ChatGPT Codex / Copilot profiles (mapped to ChatGPT-compatible backend)
CODEX_MODEL=gpt-4o-mini
COPILOT_MODEL=gpt-4o-mini

# Gemini (Google)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Perplexity
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar

# Claude (Anthropic)
CLAUDE_APIKEY=
CLAUDE_MODEL=claude-3-5-sonnet-20241022
