# React frontend
REACT_APP_AI_ASSISTANT_URL=http://localhost:5050
REACT_APP_SUPPORT_EMAIL=support@skillhive.app
REACT_APP_LEGAL_VERSION=v1.0.0
REACT_APP_LEGAL_LAST_UPDATED=2026-04-18

# AI assistant provider selection
# Supported values: ai-search, chatgpt, gemini
# Tip: ai-search works without external API keys and uses local knowledge base retrieval.
AI_PROVIDER=chatgpt
AI_ASSISTANT_PORT=5050
AI_SEARCH_QUICK_ISSUES_FILE=knowledge_base/ai_search_quick_issues.json

# ChatGPT (OpenAI)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Gemini (Google)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
