# ============================================
# SkillHive - Production Local Hardened Template
# Strict profile: ChatGPT-only active by default
# ============================================

# ---------- Node Backend ----------
NODE_ENV=production
PORT=5000
CLIENT_ORIGIN=https://your-frontend-domain.com
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/skillhive
JWT_SECRET=replace_with_long_random_secret
JWT_EXPIRE=1d

# ---------- React Frontend ----------
REACT_APP_AI_ASSISTANT_URL=https://your-ai-assistant-domain.com
REACT_APP_SUPPORT_EMAIL=support@skillhive.app
REACT_APP_LEGAL_VERSION=v1.0.0
REACT_APP_LEGAL_LAST_UPDATED=2026-04-18

# ---------- AI Assistant ----------
AI_PROVIDER=chatgpt
AI_ASSISTANT_PORT=5050
AI_SEARCH_QUICK_ISSUES_FILE=knowledge_base/ai_search_quick_issues.json

# ChatGPT (active)
OPENAI_API_KEY=your_openai_key
OPENAI_MODEL=gpt-4o-mini

# -------- Optional secondary provider (disabled by default) --------
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash

# ---------- Security Notes ----------
# 1) Never commit real keys.
# 2) Prefer secrets manager in hosting provider.
# 3) Keep CLIENT_ORIGIN exact (no wildcard).
# 4) Rotate keys periodically.
