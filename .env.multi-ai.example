# =====================================
# SkillHive - Multi Provider AI Profile
# Priority: chatgpt > gemini > grok > perplexity > claude
# =====================================

# ---------- Node Backend ----------
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000
MONGO_URI=mongodb://127.0.0.1:27017/skillhive
JWT_SECRET=replace_with_strong_secret
JWT_EXPIRE=1d

# ---------- React Frontend ----------
REACT_APP_AI_ASSISTANT_URL=http://localhost:5050
REACT_APP_SUPPORT_EMAIL=support@skillhive.app
REACT_APP_LEGAL_VERSION=v1.0.0
REACT_APP_LEGAL_LAST_UPDATED=2026-04-18

# ---------- AI Assistant ----------
AI_PROVIDER=chatgpt
AI_ASSISTANT_PORT=5050

# ChatGPT (Primary)
OPENAI_API_KEY=your_openai_key
OPENAI_MODEL=gpt-4o-mini

# ChatGPT Codex / Copilot profiles (mapped to ChatGPT backend)
CODEX_MODEL=gpt-4o-mini
COPILOT_MODEL=gpt-4o-mini

# Gemini
GEMINI_API_KEY=your_gemini_key
GEMINI_MODEL=gemini-1.5-flash

# Grok
XAI_API_KEY=your_xai_key
GROK_MODEL=grok-2-latest

# Perplexity
PERPLEXITY_API_KEY=your_perplexity_key
PERPLEXITY_MODEL=sonar

# Claude
CLAUDE_APIKEY=your_claude_key
CLAUDE_MODEL=claude-3-5-sonnet-20241022
