# =====================================
# SkillHive - Production Environment Template
# =====================================

# ---------- Node Backend ----------
NODE_ENV=production
PORT=5000
CLIENT_ORIGIN=https://your-frontend-domain.com
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/skillhive
JWT_SECRET=replace_with_long_random_secret
JWT_EXPIRE=1d

# ---------- React Frontend ----------
REACT_APP_AI_ASSISTANT_URL=https://your-ai-assistant-domain.com
REACT_APP_SUPPORT_EMAIL=support@skillhive.app
REACT_APP_LEGAL_VERSION=v1.0.0
REACT_APP_LEGAL_LAST_UPDATED=2026-04-18

# ---------- AI Assistant ----------
AI_PROVIDER=chatgpt
AI_ASSISTANT_PORT=5050

# ChatGPT (Primary)
OPENAI_API_KEY=your_openai_key
OPENAI_MODEL=gpt-4o-mini

# Optional profile labels mapped to ChatGPT-compatible route
CODEX_MODEL=gpt-4o-mini
COPILOT_MODEL=gpt-4o-mini

# Gemini
GEMINI_API_KEY=your_gemini_key
GEMINI_MODEL=gemini-1.5-flash

# Grok
XAI_API_KEY=your_xai_key
GROK_MODEL=grok-2-latest

# Perplexity
PERPLEXITY_API_KEY=your_perplexity_key
PERPLEXITY_MODEL=sonar

# Claude
CLAUDE_APIKEY=your_claude_key
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# ---------- Production Notes ----------
# 1) Do not commit real secrets.
# 2) Use your hosting platform secret manager.
# 3) Restrict CLIENT_ORIGIN to your real frontend domain.
# 4) Keep AI assistant on a dedicated domain or private network.
